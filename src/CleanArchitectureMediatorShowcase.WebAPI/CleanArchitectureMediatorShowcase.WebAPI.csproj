<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>CleanArchitectureMediatorShowcase.WebAPI</RootNamespace>
    <!-- Emit source generator files for developer inspection -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <!-- Generate XML documentation for OpenAPI metadata without requiring comments on all endpoints -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Prevent emitted generator files from being included twice in compilation -->
  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanArchitectureMediatorShowcase.Application\CleanArchitectureMediatorShowcase.Application.csproj" />
    <ProjectReference Include="..\CleanArchitectureMediatorShowcase.Infrastructure\CleanArchitectureMediatorShowcase.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mediator compile-time source generator; referenced only in the entry project -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
</Project>
