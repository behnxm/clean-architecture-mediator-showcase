{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Default SQLite connection. To switch to PostgreSQL:
    // "Host=localhost;Port=5432;Database=ProductCatalog;Username=postgres;Password=postgres"
    // To switch to SQL Server:
    // "Server=localhost;Database=ProductCatalog;Trusted_Connection=True;TrustServerCertificate=True;"
    "Database": "Data Source=productcatalog.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "LoggingBehavior": {
    "SlowRequestThresholdMilliseconds": 500
  }
}
