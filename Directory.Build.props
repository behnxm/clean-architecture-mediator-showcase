<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      CA1716: Identifiers should not match keywords (VB.NET keyword 'Error').
      Justification: 'Error' is the ubiquitous domain record name in Clean Architecture Result Pattern.
      
      CA1000: Do not declare static members on generic types.
      Justification: The Result<T> pattern and C# 11+ static abstract interface contracts (e.g. IFailureResult<TSelf>)
      require static factory methods and static abstract members on generic types.
    -->
    <NoWarn>$(NoWarn);CA1716;CA1000</NoWarn>

    <!-- Promote NuGet security audit warnings to build errors -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
