<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      CA1716: Identifiers should not match keywords (VB.NET keyword 'Error').
      Justification: 'Error' is the ubiquitous domain record name in Clean Architecture Result Pattern.
      
      CA1000: Do not declare static members on generic types.
      Justification: The Result<T> pattern and C# 11+ static abstract interface contracts (e.g. IFailureResult<TSelf>)
      require static factory methods and static abstract members on generic types.

      CA1848: Use LoggerMessage delegates for improved performance.
      Justification: Standard structured logging (ILogger.LogInformation, LogDebug, LogWarning) is utilized for readability
      and educational clarity across pipeline behaviors and event handlers.

      CA1873: Evaluation of argument may be expensive if logging is disabled.
      Justification: String interpolations and Type.Name lookups in logging calls are acceptable for this showcase domain.

      CA1859: Change return type of method to concrete type for improved performance.
      Justification: Domain event dispatcher uses polymorphic INotification? return type to facilitate open-closed extension
      for future domain event translations.

      CA1707: Identifiers should not contain underscores.
      Justification: Standard BDD unit test naming convention (Method_Scenario_Outcome) uses underscores for test method readability.

      xUnit1051: Pass TestContext.Current.CancellationToken to async methods.
      Justification: Test suites in integration and unit tests pass explicit CancellationToken.None or scoped tokens where needed.
    -->
    <NoWarn>$(NoWarn);CA1716;CA1000;CA1848;CA1873;CA1859;CA1707;xUnit1051</NoWarn>

    <!-- Promote NuGet security audit warnings to build errors -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
